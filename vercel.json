{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --prefix apps/website && npm ci --prefix apps/desktop",
  "buildCommand": "npm run build --prefix apps/website",
  "outputDirectory": "apps/website/dist",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- apps/website apps/desktop/src apps/desktop/static apps/desktop/package.json apps/desktop/package-lock.json apps/desktop/svelte.config.js vercel.json .vercelignore || exit 1",
  "trailingSlash": true,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/demo/_app/immutable/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/demo-audio/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ]
}
