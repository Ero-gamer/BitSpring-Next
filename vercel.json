{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --prefix apps/website",
  "buildCommand": "npm run build --prefix apps/website",
  "outputDirectory": "apps/website/dist",
  "ignoreCommand": "git diff --quiet HEAD^ HEAD -- apps/website vercel.json .vercelignore || exit 1",
  "trailingSlash": true,
  "headers": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "hifi-player-nu.vercel.app" }],
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
